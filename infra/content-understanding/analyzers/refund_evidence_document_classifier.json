	"fieldSchema": {
		"fields": {
			"evidence_type": {
				"type": "string",
				"method": "classify",
				"description": "Classify the document into exactly one category. Use unreadable when the content cannot be reliably interpreted. Use other when it is unrelated to supported DecisionLane refund claim evidence.",
				"enum": [
					"receipt",
					"invoice",
					"order_confirmation",
					"tracking_evidence",
					"unreadable",
					"other"
				],
				"enumDescriptions": {
					"receipt": "",
					"invoice": "",
					"order_confirmation": "",
					"tracking_evidence": "",
					"unreadable": "",
					"other": ""
				}
			},
			"confidence": {
				"type": "number",
				"method": "generate",
				"description": "Return a number from 0 to 1 representing confidence in the document classification."
			},
			"image_quality": {
				"type": "string",
				"method": "classify",
				"description": "Rate the readability of the document as good, fair, poor, or unreadable.",
				"enum": [
					"good",
					"fair",
					"poor",
					"unreadable"
				],
				"enumDescriptions": {
					"good": "",
					"fair": "",
					"poor": "",
					"unreadable": ""
				}
			},
			"reason": {
				"type": "string",
				"method": "generate",
				"description": "Explain briefly which visible or readable document features support the classification. Do not infer refund eligibility, causation, or approval."
			}
		}
	}
}
