{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "13857668303805820504"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Short environment name."
      }
    },
    "cosmosLocation": {
      "type": "string",
      "defaultValue": "canadaeast",
      "metadata": {
        "description": "Cosmos DB region."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "canadacentral",
      "metadata": {
        "description": "Primary application region."
      }
    },
    "contentSafetyLocation": {
      "type": "string",
      "defaultValue": "canadaeast",
      "metadata": {
        "description": "Content Safety region."
      }
    },
    "bootstrapImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest",
      "metadata": {
        "description": "Initial public image used before the API image is pushed."
      }
    },
    "apiImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "API container image to deploy. Pass the currently running image when redeploying infrastructure so this template does not revert the app to bootstrapImage; leave empty to use bootstrapImage for a brand new environment."
      }
    },
    "apiAcrPullRoleAssignmentName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of a pre-existing role assignment granting the API identity AcrPull on the container registry. Same adoption behavior as the Foundry role assignment params: set to update in place instead of creating a conflicting assignment."
      }
    },
    "budgetEmail": {
      "type": "string",
      "metadata": {
        "description": "Address that receives Azure budget notifications."
      }
    },
    "budgetStartDate": {
      "type": "string",
      "metadata": {
        "description": "First day of the current billing month in UTC."
      }
    },
    "foundryResourceGroup": {
      "type": "string",
      "defaultValue": "rg-foundry-models",
      "metadata": {
        "description": "Resource group containing the existing Microsoft Foundry resource."
      }
    },
    "foundryResourceName": {
      "type": "string",
      "defaultValue": "fd-resource-dev",
      "metadata": {
        "description": "Existing Microsoft Foundry resource that hosts Content Understanding."
      }
    },
    "apiFoundryRoleAssignmentName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of a pre-existing role assignment to adopt for the API identity Foundry RBAC grant, avoiding a delete-then-recreate on redeploy. Leave empty for a fresh environment."
      }
    },
    "functionFoundryRoleAssignmentName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of a pre-existing role assignment to adopt for the Function identity Foundry RBAC grant. Same purpose as apiFoundryRoleAssignmentName."
      }
    },
    "evaluationPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID of the GitHub Actions service principal that runs Foundry evaluations. Leave empty when no evaluation identity is configured."
      }
    },
    "contentUnderstandingDocumentAnalyzerId": {
      "type": "string",
      "defaultValue": "refund_evidence_document_classifier",
      "metadata": {
        "description": "Content Understanding document analyzer identifier."
      }
    },
    "contentUnderstandingImageAnalyzerId": {
      "type": "string",
      "defaultValue": "refund_evidence_image_classifier",
      "metadata": {
        "description": "Content Understanding image analyzer identifier."
      }
    },
    "contentUnderstandingApiVersion": {
      "type": "string",
      "defaultValue": "2025-11-01",
      "metadata": {
        "description": "Production Content Understanding API version."
      }
    },
    "localFrontendOrigin": {
      "type": "string",
      "defaultValue": "http://localhost:3000",
      "metadata": {
        "description": "Local frontend origin allowed to call the API and upload evidence to Blob Storage in the dev environment."
      }
    },
    "localApiOrigin": {
      "type": "string",
      "defaultValue": "http://localhost:8000",
      "metadata": {
        "description": "Local API origin allowed to call the Function App in the dev environment."
      }
    },
    "localFunctionOrigin": {
      "type": "string",
      "defaultValue": "http://localhost:7071",
      "metadata": {
        "description": "Local Function App origin allowed for same-origin tooling in the dev environment."
      }
    }
  },
  "variables": {
    "token": "[toLower(uniqueString(subscription().id, resourceGroup().id))]",
    "prefix": "[format('refundflow-{0}', parameters('environmentName'))]",
    "storageName": "[take(replace(format('st{0}{1}', variables('prefix'), variables('token')), '-', ''), 24)]",
    "cosmosName": "[take(format('{0}-cosmos-{1}', variables('prefix'), variables('token')), 44)]",
    "keyVaultName": "[take(format('{0}-kv-{1}', variables('prefix'), variables('token')), 24)]",
    "acrName": "[take(replace(format('{0}acr{1}', variables('prefix'), variables('token')), '-', ''), 50)]",
    "appName": "[format('{0}-api', variables('prefix'))]",
    "functionName": "[take(format('{0}-workflow-{1}', variables('prefix'), variables('token')), 60)]",
    "deploymentContainerName": "function-releases",
    "containerDefinitions": [
      {
        "name": "claims",
        "partitionKey": "/claim_id"
      },
      {
        "name": "work_items",
        "partitionKey": "/queue_type"
      },
      {
        "name": "users",
        "partitionKey": "/user_id"
      },
      {
        "name": "orders",
        "partitionKey": "/customer_id"
      },
      {
        "name": "system",
        "partitionKey": "/document_type"
      }
    ],
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('{0}-appi', variables('prefix'))]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix')))]",
        "DisableLocalAuth": false,
        "RetentionInDays": 30
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}-cost-alerts', variables('prefix'))]",
      "location": "global",
      "properties": {
        "groupShortName": "RefundCost",
        "enabled": true,
        "emailReceivers": [
          {
            "name": "Owner",
            "emailAddress": "[parameters('budgetEmail')]",
            "useCommonAlertSchema": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Consumption/budgets",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}-monthly-budget', variables('prefix'))]",
      "properties": {
        "amount": 50,
        "category": "Cost",
        "timeGrain": "Monthly",
        "timePeriod": {
          "startDate": "[parameters('budgetStartDate')]",
          "endDate": "2035-12-31T00:00:00Z"
        },
        "notifications": {
          "Actual50": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 50,
            "thresholdType": "Actual",
            "contactEmails": [
              "[parameters('budgetEmail')]"
            ],
            "contactGroups": [
              "[resourceId('Microsoft.Insights/actionGroups', format('{0}-cost-alerts', variables('prefix')))]"
            ],
            "contactRoles": []
          },
          "Actual70": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 70,
            "thresholdType": "Actual",
            "contactEmails": [
              "[parameters('budgetEmail')]"
            ],
            "contactGroups": [
              "[resourceId('Microsoft.Insights/actionGroups', format('{0}-cost-alerts', variables('prefix')))]"
            ],
            "contactRoles": []
          },
          "Actual90": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 90,
            "thresholdType": "Actual",
            "contactEmails": [
              "[parameters('budgetEmail')]"
            ],
            "contactGroups": [
              "[resourceId('Microsoft.Insights/actionGroups', format('{0}-cost-alerts', variables('prefix')))]"
            ],
            "contactRoles": []
          },
          "Actual100": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 100,
            "thresholdType": "Actual",
            "contactEmails": [
              "[parameters('budgetEmail')]"
            ],
            "contactGroups": [
              "[resourceId('Microsoft.Insights/actionGroups', format('{0}-cost-alerts', variables('prefix')))]"
            ],
            "contactRoles": []
          },
          "Forecast90": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 90,
            "thresholdType": "Forecasted",
            "contactEmails": [
              "[parameters('budgetEmail')]"
            ],
            "contactGroups": [
              "[resourceId('Microsoft.Insights/actionGroups', format('{0}-cost-alerts', variables('prefix')))]"
            ],
            "contactRoles": []
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', format('{0}-cost-alerts', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true,
        "minimumTlsVersion": "TLS1_2",
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Allow"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageName'), 'default')]",
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        },
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        },
        "cors": {
          "corsRules": [
            {
              "allowedOrigins": "[concat(if(equals(parameters('environmentName'), 'dev'), createArray(parameters('localFrontendOrigin')), createArray()), createArray(format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', format('{0}-web', variables('prefix'))), '2023-12-01').defaultHostname)))]",
              "allowedMethods": [
                "PUT",
                "OPTIONS"
              ],
              "allowedHeaders": [
                "content-type",
                "x-ms-blob-type",
                "x-ms-version",
                "x-ms-client-request-id"
              ],
              "exposedHeaders": [
                "x-ms-request-id",
                "etag"
              ],
              "maxAgeInSeconds": 3600
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/staticSites', format('{0}-web', variables('prefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', 'quarantine')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', 'evidence')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', variables('deploymentContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/queueServices/queues",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/notifications', variables('storageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Security/defenderForStorageSettings",
      "apiVersion": "2022-12-01-preview",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "current",
      "properties": {
        "isEnabled": true,
        "overrideSubscriptionLevelSettings": true,
        "malwareScanning": {
          "onUpload": {
            "isEnabled": true,
            "capGBPerMonth": 1
          }
        },
        "sensitiveDataDiscovery": {
          "isEnabled": false
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2024-11-15",
      "name": "[variables('cosmosName')]",
      "location": "[parameters('cosmosLocation')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "capabilities": [
          {
            "name": "EnableServerless"
          }
        ],
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        },
        "locations": [
          {
            "locationName": "[parameters('cosmosLocation')]",
            "failoverPriority": 0,
            "isZoneRedundant": false
          }
        ],
        "publicNetworkAccess": "Enabled",
        "minimalTlsVersion": "Tls12",
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2024-11-15",
      "name": "[format('{0}/{1}', variables('cosmosName'), 'refundflow')]",
      "properties": {
        "resource": {
          "id": "refundflow"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('cosmosName'))]"
      ]
    },
    {
      "copy": {
        "name": "containers",
        "count": "[length(variables('containerDefinitions'))]"
      },
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2024-11-15",
      "name": "[format('{0}/{1}/{2}', variables('cosmosName'), 'refundflow', variables('containerDefinitions')[copyIndex()].name)]",
      "properties": {
        "resource": {
          "id": "[variables('containerDefinitions')[copyIndex()].name]",
          "partitionKey": {
            "paths": [
              "[variables('containerDefinitions')[copyIndex()].partitionKey]"
            ],
            "kind": "Hash"
          },
          "indexingPolicy": {
            "indexingMode": "consistent",
            "automatic": true,
            "includedPaths": [
              {
                "path": "/*"
              }
            ],
            "excludedPaths": [
              {
                "path": "/payload/raw_text/?"
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', variables('cosmosName'), 'refundflow')]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "enablePurgeProtection": true,
        "publicNetworkAccess": "Enabled",
        "sku": {
          "family": "A",
          "name": "standard"
        }
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}-safety-{1}', variables('prefix'), variables('token'))]",
      "location": "[parameters('contentSafetyLocation')]",
      "kind": "ContentSafety",
      "sku": {
        "name": "F0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "customSubDomainName": "[format('{0}-safety-{1}', variables('prefix'), variables('token'))]",
        "disableLocalAuth": true,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}-docs-{1}', variables('prefix'), variables('token'))]",
      "location": "[parameters('location')]",
      "kind": "FormRecognizer",
      "sku": {
        "name": "F0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "customSubDomainName": "[format('{0}-docs-{1}', variables('prefix'), variables('token'))]",
        "disableLocalAuth": true,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Communication/emailServices",
      "apiVersion": "2023-04-01",
      "name": "[format('{0}-email-{1}', variables('prefix'), variables('token'))]",
      "location": "global",
      "properties": {
        "dataLocation": "United States"
      }
    },
    {
      "type": "Microsoft.Communication/emailServices/domains",
      "apiVersion": "2023-04-01",
      "name": "[format('{0}/{1}', format('{0}-email-{1}', variables('prefix'), variables('token')), 'AzureManagedDomain')]",
      "location": "global",
      "properties": {
        "domainManagement": "AzureManaged"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Communication/emailServices', format('{0}-email-{1}', variables('prefix'), variables('token')))]"
      ]
    },
    {
      "type": "Microsoft.Communication/communicationServices",
      "apiVersion": "2023-04-01",
      "name": "[format('{0}-acs-{1}', variables('prefix'), variables('token'))]",
      "location": "global",
      "properties": {
        "dataLocation": "United States",
        "linkedDomains": [
          "[resourceId('Microsoft.Communication/emailServices/domains', format('{0}-email-{1}', variables('prefix'), variables('token')), 'AzureManagedDomain')]"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Communication/emailServices/domains', format('{0}-email-{1}', variables('prefix'), variables('token')), 'AzureManagedDomain')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-aca', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-aca', variables('prefix')))]",
        "configuration": {
          "activeRevisionsMode": "Multiple",
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "secrets": [
            {
              "name": "search-query-key",
              "identity": "system",
              "keyVaultUrl": "[format('{0}secrets/azure-search-query-key', reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri)]"
            },
            {
              "name": "stripe-webhook-secret",
              "identity": "system",
              "keyVaultUrl": "[format('{0}secrets/stripe-webhook-secret', reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri)]"
            },
            {
              "name": "function-key",
              "value": "placeholder"
            }
          ],
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]",
              "identity": "system"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[if(empty(parameters('apiImage')), parameters('bootstrapImage'), parameters('apiImage'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "APP_ENV",
                  "value": "[parameters('environmentName')]"
                },
                {
                  "name": "ALLOWED_ORIGINS",
                  "value": "[join(concat(if(equals(parameters('environmentName'), 'dev'), createArray(parameters('localFrontendOrigin')), createArray()), createArray(format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', format('{0}-web', variables('prefix'))), '2023-12-01').defaultHostname))), ',')]"
                },
                {
                  "name": "COSMOS_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', variables('cosmosName')), '2024-11-15').documentEndpoint]"
                },
                {
                  "name": "COSMOS_DATABASE",
                  "value": "refundflow"
                },
                {
                  "name": "STORAGE_ACCOUNT_NAME",
                  "value": "[variables('storageName')]"
                },
                {
                  "name": "STORAGE_ACCOUNT_URL",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]"
                },
                {
                  "name": "CONTENT_SAFETY_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', format('{0}-safety-{1}', variables('prefix'), variables('token'))), '2024-10-01').endpoint]"
                },
                {
                  "name": "DOCUMENT_INTELLIGENCE_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', format('{0}-docs-{1}', variables('prefix'), variables('token'))), '2024-10-01').endpoint]"
                },
                {
                  "name": "CONTENT_UNDERSTANDING_ENDPOINT",
                  "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('foundryResourceGroup')), 'Microsoft.CognitiveServices/accounts', parameters('foundryResourceName')), '2024-10-01').endpoint]"
                },
                {
                  "name": "CONTENT_UNDERSTANDING_DOCUMENT_ANALYZER_ID",
                  "value": "[parameters('contentUnderstandingDocumentAnalyzerId')]"
                },
                {
                  "name": "CONTENT_UNDERSTANDING_IMAGE_ANALYZER_ID",
                  "value": "[parameters('contentUnderstandingImageAnalyzerId')]"
                },
                {
                  "name": "CONTENT_UNDERSTANDING_API_VERSION",
                  "value": "[parameters('contentUnderstandingApiVersion')]"
